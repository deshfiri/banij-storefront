# Banij storefront installation — server-side environment.
# Copy to .env on the server, fill in by hand, `chmod 600 .env`. Never commit it, never bake it into
# an image, never put any of these values in site/site.config.json (public configuration).

# ── Installation (required) ─────────────────────────────────────────────────────────────────────
# The central Banij ERP, HTTPS only.
BANIJ_ERP_BASE_URL=https://erp.example.com
# Website-scoped credential generated by a Banij Super Admin for THIS website (shown once).
BANIJ_CREDENTIAL_KEY_ID=
BANIJ_CREDENTIAL_SECRET=
# This installation's own Redis (carts, checkout attempts, cache). Not shared with any other website.
STOREFRONT_REDIS_URL=redis://127.0.0.1:6379/0
# The ONE public HTTPS origin (and path prefix) the ERP serves product media from. Not a secret.
# The image allow-list is fixed at build time: build with the same value (container: --build-arg),
# or the server refuses to start. A local/private address is refused on a production site.
STOREFRONT_IMAGE_ORIGIN=https://media.example.com/storage/

# ── Development only (never set in production) ──────────────────────────────────────────────────
# STOREFRONT_PUBLIC_SCHEME=http
# STOREFRONT_PUBLIC_PORT=3000
# STOREFRONT_INSECURE_COOKIES=true

# ── Legacy shared mode — development only, pending approved removal (D30, superseded by P3) ─────
# STOREFRONT_MODE=shared
# ERP_BASE_URL=https://127.0.0.1:8443
# STOREFRONT_REGISTRY_KEY=          # openssl rand -base64 32
# STOREFRONT_ROOT_DOMAIN=feriwala.shop
# STOREFRONT_DEV_HOST_SUFFIX=localhost
# STOREFRONT_PROVISIONING_HOST= / _KEY_ID= / _SECRET= / _PRIVATE_KEY=   (scripts/provisioning-keys.mjs)
